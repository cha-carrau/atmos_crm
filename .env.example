# Optional. When both are set, invite emails are sent with Resend.
# Otherwise, inviting someone opens your email app with the invite link.
RESEND_API_KEY=
EMAIL_FROM=

# Public site origin. Invite links and the Outlook callback use this when set.
# Leave unset for local development. On the hosted app this is the HTTPS URL.
# APP_URL=https://cha-carrau-atmosone.fly.dev

# Workspace file and Outlook tokens. Defaults to ./data next to the app.
# The hosted app stores this on a private disk, not in git.
# DATA_DIR=

# Microsoft Outlook sync. Copy this file to .env.local and fill in the Azure app.
# Register a Web redirect URI of exactly one of:
# http://localhost:3000/api/outlook/callback
# https://cha-carrau-atmosone.fly.dev/api/outlook/callback
# Optional override when APP_URL is not the redirect you registered:
# AZURE_REDIRECT_URI=
# Delegated Microsoft Graph permissions:
# Mail.Read, Calendars.Read, Contacts.Read, offline_access, User.Read
# Use "common" so any work, school, or personal Microsoft account can sign in.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
